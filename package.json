{
  "name": "lotus-yunzai",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "panel",
    "packages/*",
    "plugins/atlas",
    "plugins/genshin",
    "plugins/group",
    "plugins/meme",
    "plugins/notice",
    "plugins/starrail",
    "plugins/zzz",
    "plugins/system"
  ],
  "scripts": {
    "bootstrap": "bun scripts/bootstrap.ts",
    "start": "bun app.ts",
    "build:panel": "bun run --filter @lotus-yunzai/panel build",
    "typecheck": "tsc --noEmit && bun run --filter @lotus-yunzai/panel typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node-schedule": "2.1.8",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@lotus-yunzai/account": "workspace:*",
    "@lotus-yunzai/hoyo-client": "workspace:*",
    "@lotus-yunzai/skia": "workspace:*",
    "@lotus-yunzai/storage": "workspace:*",
    "@pixel.js/shotium": "0.12.4",
    "art-template": "4.13.2",
    "node-schedule": "2.1.2",
    "yaml": "2.9.1"
  },
  "trustedDependencies": [
    "skia-canvas"
  ]
}
