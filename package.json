{
  "name": "lotus-yunzai",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "panel",
    "packages/*",
    "plugins/atlas",
    "plugins/execute",
    "plugins/genshin",
    "plugins/group",
    "plugins/guides",
    "plugins/media",
    "plugins/meme",
    "plugins/notice",
    "plugins/starrail",
    "plugins/zzz",
    "plugins/system"
  ],
  "scripts": {
    "bootstrap": "bun scripts/bootstrap.ts",
    "migrate:plan": "bun --no-env-file scripts/migrate-plan.ts",
    "init": "bun --no-env-file scripts/launcher.ts init",
    "start": "bun --no-env-file scripts/launcher.ts start",
    "start:bg": "bun --no-env-file scripts/launcher.ts start:bg",
    "stop": "bun --no-env-file scripts/launcher.ts stop",
    "restart": "bun --no-env-file scripts/launcher.ts restart",
    "logs": "bun --no-env-file scripts/launcher.ts logs",
    "status": "bun --no-env-file scripts/launcher.ts status",
    "build:panel": "bun run --filter @lotus-yunzai/panel build",
    "typecheck": "tsc --noEmit && bun run --filter @lotus-yunzai/panel typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node-schedule": "2.1.8",
    "@types/qrcode": "1.5.6",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@lotus-yunzai/account": "workspace:*",
    "@lotus-yunzai/gacha": "workspace:*",
    "@lotus-yunzai/hoyo-client": "workspace:*",
    "@lotus-yunzai/skia": "workspace:*",
    "@lotus-yunzai/storage": "workspace:*",
    "@pixel.js/shotium": "0.12.4",
    "art-template": "4.13.2",
    "node-schedule": "2.1.2",
    "qrcode": "1.5.4",
    "yaml": "2.9.1"
  },
  "trustedDependencies": [
    "skia-canvas"
  ]
}
