{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": ["app.ts", "lib/**/*.ts", "scripts/**/*.ts", "packages/**/*.ts", "plugins/**/*.ts", "test/**/*.ts", "web/miyoushe/**/*.ts"]
}
